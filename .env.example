TWOGIS_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Необязательно: запасной тариф, если провайдер не прислал usage.cost (OpenRouter присылает).
LLM_USD_PER_1M_PROMPT=
LLM_USD_PER_1M_COMPLETION=
# Прокси: http://USER:PASSWORD@HOST:PORT (свой, не публичный). Пусто = без прокси.
HTTP_PROXY=
HTTPS_PROXY=
# LLM без прокси (1 = прямой запрос к LLM_BASE_URL, для отладки ProxyError).
LLM_DIRECT=
