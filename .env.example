TWOGIS_API_KEY=
LLM_API_KEY=
# Kie: хост без модели. Путь /{LLM_MODEL}/v1/chat/completions собирает клиент.
# Ключ тот же, что KIE_API_KEY. https://docs.kie.ai/market/gemini/gemini-3-flash
LLM_BASE_URL=https://api.kie.ai/
LLM_MODEL=gemini-3-flash
# Необязательно: запасной тариф, если провайдер не прислал usage.cost (OpenRouter присылает).
LLM_USD_PER_1M_PROMPT=
LLM_USD_PER_1M_COMPLETION=
# Прокси: http://USER:PASSWORD@HOST:PORT — схема http:// даже для HTTPS-сайтов.
HTTP_PROXY=
HTTPS_PROXY=
# LLM без прокси (1 = прямой запрос к LLM_BASE_URL, для отладки ProxyError).
LLM_DIRECT=
